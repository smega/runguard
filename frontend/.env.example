# Copy to frontend/.env and fill in your own values. .env is gitignored
# (see the repo's *.env rule) — never commit real values.
#
# Used by vite.config.js directly (dev-server API proxy target):
VITE_API_PROXY_TARGET=http://localhost:8888

# Used by src/siteConfig.js (imported by the pages that need them):
VITE_PUBLIC_BASE_URL=https://your-domain.example
VITE_PUBLIC_STATUS_BASE_URL=https://status.your-domain.example
VITE_CLI_DOWNLOAD_BASE=https://downloads.your-domain.example
VITE_INSTALL_SCRIPT_URL=https://your-domain.example/install.sh
VITE_PRIVACY_EMAIL=privacy@your-domain.example
VITE_LEGAL_EMAIL=legal@your-domain.example
VITE_SECURITY_EMAIL=security@your-domain.example
