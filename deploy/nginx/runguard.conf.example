# Sample nginx config for a self-hosted RunGuard instance: TLS termination,
# the Preact frontend served as static files, and the Go backend reverse-
# proxied underneath it. Copy, rename (drop .example), and fill in the
# placeholders before using.
#
# Layout assumed:
#   - frontend build output (`frontend/dist`) synced to /srv/runguard/frontend
#     (matches _build/build_preact.sh's default REMOTE_DIR)
#   - backend listening on 127.0.0.1:8888 (server.addr in config.yml)
#
# Auth model: the web UI (`/`) sits behind HTTP Basic Auth -- useful for a
# pre-launch/private instance, remove the auth_basic lines once you're ready
# for real signup/login to be the only gate. `/api/` and `/hb/` must NOT be
# Basic-Auth-gated: the CLI agent and anything hitting a heartbeat URL has
# no way to send Basic Auth credentials, only its own job/agent token.
#
# Create the password file once:
#   sudo htpasswd -c /etc/nginx/runguard.htpasswd youruser

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name your-domain.example;

    ssl_certificate     /etc/letsencrypt/live/your-domain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.example/privkey.pem;

    root /srv/runguard/frontend;
    index index.html;

    # Backend API -- open, no Basic Auth (agent tokens/heartbeat keys are
    # the auth for these, enforced by the backend itself).
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8888;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Heartbeat endpoint the CLI/cron jobs post to -- also open, same reason.
    location ^~ /hb/ {
        proxy_pass http://127.0.0.1:8888;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:8888;
    }

    # Everything else is the frontend. Remove the two auth_basic lines once
    # you don't want a blanket login prompt in front of the web UI.
    location / {
        auth_basic "RunGuard";
        auth_basic_user_file /etc/nginx/runguard.htpasswd;

        try_files $uri $uri/ /index.html;
    }
}
