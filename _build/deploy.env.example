# Copy to _build/deploy.env and fill in your own values — each _build/*.sh
# script sources this automatically if it exists. deploy.env is gitignored
# (see the repo's *.env rule); this .env.example file is the only one
# that's committed.
#
# Every one of these can also just be exported in your shell instead —
# this file exists purely to save you from re-exporting them every time.

REMOTE_USER=root
REMOTE_HOST=your-server.example.com
SSH_KEY=$HOME/.ssh/id_ed25519

# build_go.sh only:
REMOTE_DIR=/srv/runguard/backend

# build_preact.sh uses its own REMOTE_DIR — set it separately if deploying
# both from the same deploy.env (e.g. REMOTE_DIR=/srv/runguard/frontend).

# build_runguard_cli.sh only — optional, bakes these into the CLI binaries
# you publish via -ldflags, instead of shipping the placeholder defaults.
# Leave unset to publish binaries that require --api/--download-base.
#RUNGUARD_API_BASE=https://your-domain.example
#RUNGUARD_VERSIONS_API=https://your-domain.example/api/public/cli/versions
#RUNGUARD_DOWNLOAD_BASE=https://downloads.your-domain.example
